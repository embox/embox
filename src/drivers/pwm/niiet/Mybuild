package embox.driver.pwm

module niiet_dma_drv {
	option string log_level="LOG_ERR"

	source "niiet_dma_drv.c"

	@IncludeExport(path="drivers")
	source "niiet_dma.h"

	@NoRuntime depends embox.driver.clk.core
}

module niiet_pwm_drv {
	option string log_level="LOG_ERR"

	option number vg1t_version = 0

	source "niiet_pwm_drv.c"

	depends embox.driver.pwm.pwm_dev
	depends embox.driver.pwm.niiet_dma_drv

	@NoRuntime depends embox.driver.clk.core
}

module niiet_pwm0 {
	option number base_addr = 0
	option number clk_div = 1

	source "niiet_pwm0.c"

	depends niiet_pwm_drv
}

module niiet_pwm1 {
	option number base_addr = 0
	option number clk_div = 1

	source "niiet_pwm1.c"

	depends niiet_pwm_drv
}

module niiet_pwm2 {
	option number base_addr = 0
	option number clk_div = 1

	source "niiet_pwm2.c"

	depends niiet_pwm_drv
}

module niiet_pwm3 {
	option number base_addr = 0
	option number clk_div = 1

	source "niiet_pwm3.c"

	depends niiet_pwm_drv
}

module niiet_pwm32 {
	option number base_addr = 0
	option number clk_div = 1

	source "niiet_pwm32.c"

	depends niiet_pwm_drv
}
