	source "xattr.c"

	depends embox.driver.ramdisk
}

module mount_test {
	source "mount_test.c"
	option string share_path="10.0.2.10:/var/nfs_test"
	option string fs_type="nfs"
}

module fs_test_read {
	source "fs_test_r.c"
}

module fs_test_write {
